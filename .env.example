# Дедал — този checkout е продуктът
# Копирай към .env или export-ни в shell.

DAEDALUS_STANDALONE=1
HOST=127.0.0.1
PORT=8787
# Windows Start Menu app sets DAEDALUS_WINDOWS_APP=1 and keeps data in
# %LOCALAPPDATA%\Daedalus — do not put API keys in Program Files.

# OpenAI-compatible LLM (at least one) — or use a local provider below
ALLTOKEN_API_KEY=
OPENROUTER_API_KEY=
NOVITA_API_KEY=
NVIDIA_API_KEY=

# Local LLM (Ollama / LM Studio / llama.cpp / vLLM) — no API key on loopback
# DAEDALUS_LOCAL_LLM=1
# DAEDALUS_PROVIDER=ollama
# DAEDALUS_MODEL=qwen2.5-coder:7b
# OLLAMA_HOST=127.0.0.1:11434
# Optional OpenAI-compat sidecar (not vendored). Preset: omniroute.
# DAEDALUS_PROVIDER=omniroute
# DAEDALUS_MODEL=auto
# OMNIROUTE_API_KEY=
# DAEDALUS_OFFLINE=1          # refuse web/jina/image-gen; use wardrobe + playground
# DAEDALUS_EVOLUTION=1        # opt-in idle gardener (Studio → Еволюция). Default off.
# DAEDALUS_EVOLUTION=0        # kill switch even if settings.json says on
# DAEDALUS_EVOLUTION_LLM=1    # allow a short for_self chat during a cycle (else only local LLM)
# Studio Brain / Connectors Brain switch models without editing this file (wardrobe.json).
# That choice is the brain for chat, workers, autopilot, and CLI — not Studio-only.
# Native tools are on by default; set DAEDALUS_NATIVE_TOOLS=0 to use NEED_* only.
# DAEDALUS_QUALITY=0          # opt out of the visual critic (default on; skip is still not OK)
# DAEDALUS_VISUAL_PROOF=0     # opt out of kernel-run browser/Godot proof after the last write
# DAEDALUS_WRITE_GATE=0       # opt out of write_file syntax/arcade gate (duplicate let, missing canvas)
# DAEDALUS_BUILD_FIX_ROUNDS=3 # PLAN PROGRESS nudges when the build plan is incomplete
# GODOT_BIN=                  # Godot 4.3 binary; missing fails godot kinds
# GODOT_EXPORT_TEMPLATES=     # Godot 4.3 export templates dir; missing fails Stage 7
# DAEDALUS_GODOT_PIN=1        # 0 allows other Godot 4.x; Godot 3 always fails
# ANDROID_HOME=               # Android SDK; missing fails MobileAdapter export
# EAS_TOKEN=                  # Expo EAS; Expo web export is not a native pass
# UNITY_PATH=                 # Unity Editor; missing fails unity kinds
# DAEDALUS_LAB_BACKEND=auto   # auto | local | smolvm | docker
# DAEDALUS_SMOLVM=0           # never boot SmolVM even if installed
# pip install '.[computer]'   # optional SmolVM guest browser (not vendored)
# FAL_KEY=                    # fal.ai — assets({action:mesh}) Hunyuan/Trellis
# FAL_API_KEY=                # alias for FAL_KEY
# TRIPO_API_KEY=              # Tripo text-to-3D (fail closed if unset)
# MESHY_API_KEY=              # Meshy text-to-3D (fail closed if unset)
# SUNO_API_KEY=               # recorded only — no Suno submit; drop assets/music.mp3
# DAEDALUS_FULL_PERSONA=1     # append the long identity prompt (default is the compact contract)

# Optional MiroFish-Offline sidecar (AGPL — separate process, do not vendor)
# MIROFISH_URL=http://127.0.0.1:5001
# MIROFISH_UI=http://127.0.0.1:3000

# Live publish (Studio → Наживо) and git forges. Optional.
# Keys can also be set in Studio → Свързаност ($DAEDALUS_DATA/secrets.env).
# NETLIFY_AUTH_TOKEN=   # durable *.netlify.app  https://app.netlify.com/user/applications
# GITLAB_TOKEN=         # Pages + clone/push/Merge Request (scope api + write_repository)
# GITHUB_TOKEN=         # clone/push/Pull Request (classic PAT, scope repo)
# Node.js (npx) enables a 1-hour Netlify preview with no account.

# Optional MCP servers: Studio → Connectors, or $DAEDALUS_DATA/mcp.json
# Prefer pinned argv/url. Unverified npx -y does not spawn (DAEDALUS_MCP_POLICY=enforce).
# DAEDALUS_MCP_POLICY=enforce
# DAEDALUS_MCP_POLICY_FILE=   # default $DAEDALUS_DATA/mcp_policy.json
# { "servers": { "blender-mcp": { "command": "python3", "args": ["-m", "daedalus.blender_mcp"] } } }
# UI-managed secrets: $DAEDALUS_DATA/secrets.env (do not commit)

# Shared secret for the optional HTTP peer ping. Empty = ask/chat refused.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# IYVERIS_MESH_KEY=

# Optional overrides
# DAEDALUS_DATA=/var/lib/daedalus
# DAEDALUS_PLAYGROUND=/var/lib/daedalus/playground

# Owner token — required before a public bind (Docker HOST=0.0.0.0, VPS).
# Loopback `daedalus serve` writes $DAEDALUS_DATA/owner.token on first boot.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# DAEDALUS_TOKEN=
# DAEDALUS_SHELL_ISOLATION=1   # allow run_command on a public bind (still not a container)
# DAEDALUS_SHELL_LEGACY=1      # opt in to shell metacharacters locally
# DAEDALUS_EXEC_BACKEND=local  # local | host | docker (fail-closed without docker)
# DAEDALUS_EXEC_IMAGE=daedalus-exec:p018
# DAEDALUS_EXEC_PULL=0         # 1 = allow docker pull of the exec image
# DAEDALUS_EXEC_NETWORK=0      # 1 = allow container network (default --network none)
# DAEDALUS_EXEC_CPUS=1
# DAEDALUS_EXEC_MEMORY=512m
# DAEDALUS_EXEC_PIDS=128
# DAEDALUS_WORKTREE=0          # 1 = per-run git worktree under $DAEDALUS_DATA/worktrees (default off)
# DAEDALUS_CONTEXT_WINDOW=     # optional token window for ContextBudget leaf (unset = model table)
# DAEDALUS_OTEL=0              # 1 = OpenTelemetry leaf (needs OTEL_EXPORTER_OTLP_ENDPOINT)
# DAEDALUS_INDEPENDENT_REVIEW=0  # 1 = IndependentReviewer leaf (checklist; optional LLM)
# DAEDALUS_INDEPENDENT_REVIEW_LLM=0  # 1 = injected llm_fn overlay (skip ≠ ok if missing)
# DAEDALUS_SUPPLY_CHAIN=0       # 1 = SupplyChain leaf (lock/pin inspect; skip ≠ ok)
# OTEL_EXPORTER_OTLP_ENDPOINT= # gRPC collector, e.g. http://127.0.0.1:4317
# OTEL_SERVICE_NAME=daedalus
