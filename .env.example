# Daedalus — standalone product
# Copy to .env or export in the shell.

DAEDALUS_STANDALONE=1
HOST=0.0.0.0
PORT=8787

# OpenAI-compatible LLM (at least one)
ALLTOKEN_API_KEY=
OPENROUTER_API_KEY=
NOVITA_API_KEY=
NVIDIA_API_KEY=

# Optional explicit model
# DAEDALUS_PROVIDER=alltoken
# DAEDALUS_MODEL=gemini-3.1-flash-lite-preview
# DAEDALUS_API_KEY=
# DAEDALUS_BASE_URL=

# Keep OFF unless this process should reuse ADN Postgres/MeshRouter
# DAEDALUS_USE_MESH_ROUTER=0
# DAEDALUS_USE_ADN_DB=0

IYVERIS_MESH_KEY=iyveris-mesh-dev-key

# Optional overrides
# DAEDALUS_DATA=/var/lib/daedalus
# DAEDALUS_PLAYGROUND=/var/lib/daedalus/playground
