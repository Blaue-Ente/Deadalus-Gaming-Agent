# Дедал — този checkout е продуктът
# Копирай към .env или export-ни в shell.

DAEDALUS_STANDALONE=1
HOST=127.0.0.1
PORT=8787
# Windows Start Menu app sets DAEDALUS_WINDOWS_APP=1 and keeps data in
# %LOCALAPPDATA%\Daedalus — do not put API keys in Program Files.

# OpenAI-compatible LLM (at least one) — or use a local provider below
ALLTOKEN_API_KEY=
OPENROUTER_API_KEY=
NOVITA_API_KEY=
NVIDIA_API_KEY=

# Local LLM (Ollama / LM Studio / llama.cpp / vLLM) — no API key on loopback
# DAEDALUS_LOCAL_LLM=1
# DAEDALUS_PROVIDER=ollama
# DAEDALUS_MODEL=qwen2.5-coder:7b
# OLLAMA_HOST=127.0.0.1:11434
# DAEDALUS_OFFLINE=1          # refuse web/jina/image-gen; use wardrobe + playground
# DAEDALUS_EVOLUTION=1        # opt-in idle gardener (Studio → Еволюция). Default off.
# DAEDALUS_EVOLUTION=0        # kill switch even if settings.json says on
# DAEDALUS_EVOLUTION_LLM=1    # allow a short for_self chat during a cycle (else only local LLM)
# Studio LLM tab can switch models without editing this file (wardrobe.json).
# Native tools are on by default; set DAEDALUS_NATIVE_TOOLS=0 to use NEED_* only.
# DAEDALUS_FULL_PERSONA=1     # append the long identity prompt (default is the compact contract)

# Optional MiroFish-Offline sidecar (AGPL — separate process, do not vendor)
# MIROFISH_URL=http://127.0.0.1:5001
# MIROFISH_UI=http://127.0.0.1:3000

# Live publish (Studio → Наживо). Optional — GitLab token also works.
# NETLIFY_AUTH_TOKEN=   # durable *.netlify.app  https://app.netlify.com/user/applications
# GITLAB_TOKEN=         # durable GitLab Pages (public daedalus-{slug} project)
# Node.js (npx) enables a 1-hour Netlify preview with no account.

# Optional MCP servers: $DAEDALUS_DATA/mcp.json
# { "servers": { "name": { "command": "npx", "args": ["-y", "…"] } } }

# Shared secret for the optional HTTP peer ping. Change before a public bind.
IYVERIS_MESH_KEY=iyveris-mesh-dev-key

# Optional overrides
# DAEDALUS_DATA=/var/lib/daedalus
# DAEDALUS_PLAYGROUND=/var/lib/daedalus/playground
